{
  "name": "church-display",
  "version": "0.2.1",
  "description": "Jesus Tabernacle: live captions and scripture overlay for church services",
  "main": "main.js",
  "author": "Tosin Builds",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "org.jesustabernacle.display",
    "productName": "Jesus Tabernacle",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "logo.png",
      "config.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}